// Configuración de Cloudflare Workers (donde se publica la web).
// Las claves secretas NO van aquí: se ponen con `npx wrangler secret put NOMBRE`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laksmir",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Hyperdrive: mantiene abiertas las conexiones con TiDB para que cada visita vaya rápida.
  // PENDIENTE: pon aquí el id que da `npx wrangler hyperdrive create` (ver README).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "PENDIENTE_ID_DE_HYPERDRIVE"
      // Para probar en el ordenador (`npm run preview`) se usa la base de datos local: la dirección
      // se pone en .dev.vars como CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (no se sube a GitHub)
    }
  ],
  // Variables que no son secretas
  "vars": { "MANTENIMIENTO": "true" }
}
